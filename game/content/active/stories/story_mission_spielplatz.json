            "labelKey": "story_mission_spielplatz.check_outcome.good.label",
            "when": { "all": [ { "path": "flags.built_barrierefrei", "op": "exists" }, { "any": [ { "path": "flags.built_rutsche", "op": "exists" }, { "path": "flags.built_fussball", "op": "exists" }, { "path": "flags.built_ruhebereich", "op": "exists" } ] } ] },
            "effects": [],
            "to": "good"
          },
          {
            "id": "middle",
            "labelKey": "story_mission_spielplatz.check_outcome.middle.label",
            "when": { "all": [ { "not": { "path": "flags.built_barrierefrei", "op": "exists" } }, { "any": [ { "path": "flags.built_rutsche", "op": "exists" }, { "path": "flags.built_fussball", "op": "exists" } ] } ] },
            "effects": [],
            "to": "middle"
          },
          {
            "id": "weak",
            "labelKey": "story_mission_spielplatz.check_outcome.weak.label",
            "when": { "all": [] },
            "effects": [],
            "to": "weak"
          }
        ]
      },
