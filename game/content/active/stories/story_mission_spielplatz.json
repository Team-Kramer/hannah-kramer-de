        "id": "good",
        "type": "outcome",
        "locationId": "spielplatz",
        "captionKey": "story_mission_spielplatz.good.caption",
        "illustration": { "assetId": "illus_joy_barrier_free" },
        "effects": [
          { "op": "resource.add", "resourceId": "mut_sterne", "amount": 15 },
          { "op": "resource.add", "resourceId": "freundschaft", "amount": 20 },
          { "op": "flag.set", "flagId": "licht_rat_unlocked", "value": true }
